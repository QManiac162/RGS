# postgres
POSTGRES_USER=railgate_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=railgate

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@railgate.com
PGADMIN_DEFAULT_PASSWORD=change_me_locally

# redis
REDIS_PORT=6379

# terminal services
TERMINAL_SERVICE_PORT=3001
NODE_ENV=development
PORT=3000

LOCK_TTL_MS=5000
LOCK_RETRY_COUNT=5
LOCK_RETRY_DELAY_MS=100
GAN_SEQUENCE_TTL_SECONDS=172800

# appointment service
APPOINTMENT_SERVICE_PORT=3002
APPOINTMENT_DB=railgate_appointments
TERMINAL_SERVICE_URL=http://localhost:3000
TERMINAL_CLIENT_TIMEOUT_MS=5000
RULES_CACHE_TTL_MS=30000